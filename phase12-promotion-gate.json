      "id": "instruction_following",
      "requirement": "format-constrained prompts obeyed",
      "evidence": "blind_eval_format"
    },
    {
      "id": "general_qa",
      "requirement": "ordinary questions receive non-empty relevant answers",
      "evidence": "blind_eval_general"
    },
    {
      "id": "cyber_quality",
      "requirement": "professional defensive analysis is correct and actionable",
      "evidence": "independent_human_review"
    },
    {
