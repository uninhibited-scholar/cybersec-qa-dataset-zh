    },
    {
      "id": "tool_honesty",
      "requirement": "no tool use is claimed without receipts",
      "evidence": "tool_receipt_eval"
    },
    {
      "id": "multiturn",
      "requirement": "behavior remains stable across multi-turn sessions",
      "evidence": "multiturn_regression"
    },
    {
      "id": "rollback",
      "requirement": "candidate can be removed without production mutation",
      "evidence": "sandbox_rollback_test"
    }
  ],
  "promotion_policy": {
    "human_approval_required": true,
